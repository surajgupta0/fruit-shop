# =============================================================================
# Fruit Shop API (services/api) — environment template
# =============================================================================
# Copy this file and fill in real values. NEVER commit the copy.
#
#   Docker / `make dev`          ->  cp .env.example .env.dev          (repo root)
#   Run API without Docker       ->  cp .env.example services/api/.env
#   Render / Railway / VPS       ->  paste each KEY=value into the host's env settings
#
# Frontend variables live in frontend/storefront/.env.example and
# frontend/admin/.env.example (they only need NEXT_PUBLIC_API_URL).
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# dev | staging | production
ENVIRONMENT=dev
SERVICE_NAME=fruit-shop-api

# -----------------------------------------------------------------------------
# Database (PostgreSQL 14+)
# -----------------------------------------------------------------------------
# Option A: one connection string (wins over DB_* below when set).
# Neon example:
#   DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/fruitshop?sslmode=require
DATABASE_URL=

# Option B: individual parameters (used when DATABASE_URL is empty).
# Local Docker Postgres from the README: DB_HOST=localhost (or host.docker.internal
# when the API itself runs inside Docker).
DB_HOST=localhost
DB_PORT=5432
DB_USER=fruitshop
DB_PASSWORD=fruitshop
DB_NAME=fruitshop

# SSL mode:
#   disable     -> plain local Postgres
#   require     -> Neon, Supabase, Render Postgres, most managed DBs (encrypt, no CA check)
#   verify-ca   -> Aiven (also set DB_SSL_CA or DB_SSL_CA_PEM)
#   verify-full -> verify CA + hostname
DB_SSLMODE=disable
# Path to CA PEM inside the container (verify-ca / verify-full only).
# Render Secret File: /etc/secrets/aiven-ca.pem   Local Docker: /app/certs/aiven-ca.pem
DB_SSL_CA=
# Alternative to DB_SSL_CA: paste the PEM contents (use \n for newlines).
DB_SSL_CA_PEM=

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# -----------------------------------------------------------------------------
# OTP (customer sign-in on the storefront)
# -----------------------------------------------------------------------------
OTP_TTL_MINUTES=5
OTP_LENGTH=6
# Fixed code accepted for EVERY phone/email; SMS/email is not sent.
# Handy for dev/staging. MUST be empty in production or anyone can log in
# as any customer.
OTP_STATIC_CODE=123456

# -----------------------------------------------------------------------------
# Email (SMTP) — OTP emails, password reset, order notifications
# -----------------------------------------------------------------------------
# Leave SMTP_HOST empty to print emails to the API logs instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fruit Shop <noreply@fruitshop.example>
SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# SMS — customer phone OTP + order SMS
# -----------------------------------------------------------------------------
# log    -> print SMS to API logs (default)
# twilio -> send through Twilio
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 format, e.g. +15005550006
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Admin password reset
# -----------------------------------------------------------------------------
PASSWORD_RESET_TTL_MINUTES=60
# Link placed in the reset email. Point it at the admin app:
#   https://admin.yourdomain.com/reset-password
PASSWORD_RESET_URL_BASE=http://localhost:3001/reset-password

# -----------------------------------------------------------------------------
# CORS — comma-separated browser origins allowed to call the API
# -----------------------------------------------------------------------------
# Production: list your storefront and admin URLs exactly (scheme + host, no trailing slash).
#   CORS_ORIGINS=https://shop.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
